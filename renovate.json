{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "reviewers": ["france-berteloot"],
  "assignees": ["france-berteloot"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pin docker-tooling image version in CI/CD and Makefile",
      "fileMatch": [
        "(^|/)\\.github/workflows/[^/]+\\.ya?ml$",
        "(^|/)Makefile$"
      ],
      "matchStrings": [
        "TOOLING_VERSION:\\s*\"(?<currentValue>[^\"]+)\"",
        "ghcr\\.io/france-berteloot/docker-tooling:(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/france-berteloot/docker-tooling"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "Terraform providers",
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/france-berteloot/docker-tooling"],
      "groupName": "docker-tooling",
      "automerge": false
    },
    {
      "matchManagers": ["helmv3"],
      "enabled": false,
      "description": "Disabled: helmv3 only tracks Chart.yaml dependencies (external charts). demo-app is a local chart with no deps — enable when we add chart dependencies."
    }
  ],
  "terraform": {
    "fileMatch": ["\\.tf$"]
  }
}
